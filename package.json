{
  "name": "mischief",
  "displayName": "Mischief",
  "version": "0.3.2",
  "description": "A VS Code Workspace and Agent Thread browser for MagPi, Claude Agent, and Codex.",
  "categories": [
    "Chat",
    "Other"
  ],
  "keywords": [
    "acp",
    "agent",
    "claude",
    "codex",
    "herdr",
    "magpi",
    "magpie",
    "manager",
    "pi",
    "workspace"
  ],
  "homepage": "https://github.com/digital-overground/mischief#readme",
  "bugs": {
    "url": "https://github.com/digital-overground/mischief/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/digital-overground/mischief"
  },
  "publisher": "digital-overground",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "node esbuild.mjs && node scripts/smoke-extension.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "install:local": "pnpm check && pnpm exec vsce package --no-dependencies && code --install-extension \"mischief-$(node -p 'require(\"./package.json\").version').vsix\" --force",
    "lint": "ultracite check",
    "test": "vitest run --passWithNoTests --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "^5.7.0",
    "ultracite": "7.12.0",
    "vitest": "^3.0.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mischief",
          "title": "Mischief",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mischief": [
        {
          "id": "mischief.view",
          "name": "Mischief",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "mischief.addWorkspace",
        "title": "Mischief: Add Workspace…",
        "icon": "$(add)"
      },
      {
        "command": "mischief.refresh",
        "title": "Mischief: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mischief.expandAll",
        "title": "Mischief: Expand Current Workspace",
        "icon": "$(expand-all)"
      },
      {
        "command": "mischief.collapseAll",
        "title": "Mischief: Collapse Current Workspace",
        "icon": "$(collapse-all)"
      },
      {
        "command": "mischief.newThread",
        "title": "Mischief: New Thread"
      },
      {
        "command": "mischief.addSelectionToCurrentThread",
        "title": "Mischief → Current Thread"
      },
      {
        "command": "mischief.addSelectionToNewThread",
        "title": "Mischief → Start New Thread"
      },
      {
        "command": "mischief.settings",
        "title": "Mischief: Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mischief.addSelectionToCurrentThread",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == git)",
          "group": "1_chat@-2"
        },
        {
          "command": "mischief.addSelectionToNewThread",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == git)",
          "group": "1_chat@-1"
        }
      ],
      "view/title": [
        {
          "command": "mischief.settings",
          "when": "view == mischief.view",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Mischief",
      "properties": {
        "mischief.assignWorkspaceColors": {
          "type": "boolean",
          "default": true,
          "description": "Automatically assign Workspace window colors from the active theme."
        },
        "mischief.defaultAgent": {
          "type": "string",
          "default": "",
          "description": "Default Agent for new Threads. Leave empty to choose an Agent each time. Existing Threads keep their original Agent."
        },
        "mischief.copyIgnoredItems": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Ignored Project files and folders selected for copying to new Workspaces. Stored in the Project root's .vscode/settings.json."
        },
        "mischief.projectSetup": {
          "type": "object",
          "description": "Project-specific setup command, approval, and input hashes. Edit with the Mischief Project setup dialog; stored in the Project root's .vscode/settings.json."
        },
        "mischief.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Font family for Mischief chat text. Empty uses a system monospace font."
        },
        "mischief.magpiAcpPath": {
          "type": "string",
          "default": "",
          "description": "Development override for MagPi's executable or built index.js. Empty uses the managed MagPi install when available, then magpi-acp from PATH. Reload the window after changing it."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "packageManager": "pnpm@10.32.1",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  }
}
